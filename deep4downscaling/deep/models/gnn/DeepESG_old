                edge_index_latent_to_high,
                f_latent=None,
                edge_index_latent_to_latent=None):
        """
        Forward pass:
        - x_low: low-res node features [N_low, C_in]
        - edge_index_low_to_latent: edges low -> latent
        - x_latent: initial latent features [N_latent, latent_dim] or None
        - edge_index_latent_to_high: edges latent -> high
        - edge_index_latent_to_latent: edges latent -> latent (optional)
        - x_high: initial high-res features (optional)
        - edge_index_high_to_high: edges high -> high (optional)
        """

        # --- Encoder: Low -> Latent ---
        h_latent = self.encoder(x_low, edge_index_low_to_latent)  # [N_latent, latent_dim]

        # --- Processor: Latent -> Latent message passing (optional) ---
        if edge_index_latent_to_latent is not None:
            h_latent = self.processor(h_latent, edge_index_latent_to_latent, f_latent)

        # --- Decoder: Latent -> High ---
